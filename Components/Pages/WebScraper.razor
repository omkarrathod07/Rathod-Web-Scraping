﻿
@page "/webscraper"
@rendermode InteractiveServer

@using HtmlAgilityPack
@using System.Net.Http
@using System.Text.Json
@using System.Threading.Tasks
@using System.Text

@using RathodWebScraping.Services

@inject HtmlScraperService HtmlScraperService

@using Microsoft.Extensions.AI;
@inject IChatClient ChatClient

@using System.Text.RegularExpressions

<PageTitle>Web Scraper Analytics Console</PageTitle>

<div class="container py-4" style="max-width: 900px;">
    <h1 class="text-center mb-2 fw-bold text-primary">Rathod Web Scraping</h1>
    <h5 class="text-center text-muted mb-4">Generate Insights via Unified Multimodal Pipelines</h5>
    <div class="card shadow-sm p-4 mb-4 scraper-panel-card">
        <div class="form-group mb-3">
            <label class="form-label fw-semibold">Target Web Address Destination URL:</label>
            <textarea @bind="targetUrl" class="form-control scraper-input-field" rows="2" placeholder="Enter full URL path (e.g., https://ygminds.com)"></textarea>
        </div>

        <div class="d-flex flex-wrap justify-content-center gap-2">
            <button @onclick="ServiceScrapeAndProcess" class="btn btn-primary px-3 py-2 fw-semibold" disabled="@isLoading">
                🌐 Web Scrape URL
            </button>
            <button @onclick="@(() => ProcessUrLImage(imageUrl!, 1))" class="btn btn-outline-secondary px-3 py-2 fw-semibold" disabled="@(isLoading || string.IsNullOrEmpty(imageUrl))">
                🖼️ Analyze First Image
            </button>
            <button @onclick="ScrapeAndProcessMSextensions" class="btn btn-success px-3 py-2 fw-semibold" disabled="@(isLoading || string.IsNullOrEmpty(extractedData))">
                🧠 Generate Site Insight
            </button>
        </div>

        @if (isLoading || statusAI == "Processing...")
        {
            <div class="text-center mt-3 p-2 bg-opacity-10 bg-secondary rounded d-flex align-items-center justify-content-center gap-2">
                <span class="spinner-border spinner-border-sm text-primary" role="status" aria-hidden="true"></span>
                <span class="text-muted fw-medium">Executing system requests: @statusScrape @statusAI...</span>
            </div>
        }
    </div>
    @if ((isImageURL1 && !string.IsNullOrEmpty(imageUrl)) || (isImageURL2 && !string.IsNullOrEmpty(newImageURL)))
    {
        <div class="card shadow-sm text-center p-4 mb-4 scraper-panel-card">
            <h6 class="fw-bold mb-3 text-secondary">Active Vision Pipeline Target Target Element Image</h6>
            <img src="@(isImageURL1 ? imageUrl : newImageURL)" alt="Target Media Canvas" class="img-fluid rounded shadow border mx-auto" style="max-width: 100%; max-height: 280px; object-fit: contain;" />
            <div class="mt-3 small text-muted">
                <strong>Image Weight:</strong> <span class="badge bg-dark">@imageFileSize bytes</span>
            </div>
        </div>
    }
    @if (imageUrls != null && imageUrls.Count > 0)
    {
        <div class="card shadow-sm p-3 mb-4 scraper-panel-card">
            <div class="fw-bold text-muted small text-uppercase mb-2" style="letter-spacing: 0.5px;">
                📸 Extracted Media Matrix Asset Links (Click an asset element to initialize AI Vision parsing)
            </div>
            <div class="d-flex flex-wrap gap-2 p-2 image-gallery-container">
                @foreach (var img in imageUrls)
                {
                    if (!string.IsNullOrEmpty(img))
                    {
                        <div @onclick="@(() => ProcessUrLImage(img, 2))" class="image-gallery-thumb">
                            <img src="@img" style="width: 100%; height: 100%; object-fit: cover;" alt="Matrix payload reference thumb" />
                        </div>
                    }
                }
            </div>
        </div>
    }
    <div class="card shadow-sm mb-4 border-start border-4 border-info scraper-panel-card">
        <div class="card-header bg-opacity-10 bg-info fw-bold d-flex justify-content-between align-items-center">
            <span>🧠 Deep Intelligent Analytics Summary Breakdown</span>
            <span class="badge bg-info text-white text-uppercase">@statusAI</span>
        </div>
        <div class="card-body" style="min-height: 80px;">
            @if (!string.IsNullOrEmpty(responseMessage))
            {
                <div class="text-wrap">@((MarkupString)responseMessage)</div>
            }
            else
            {
                <span class="text-muted italic small">No active content analytics generated. Submit an execution request above to render details.</span>
            }
        </div>
    </div>
    <div class="card shadow-sm mb-4 border-start border-4 border-secondary scraper-panel-card text-wrap">
        <div class="card-header bg-opacity-10 bg-secondary fw-bold d-flex justify-content-between align-items-center">
            <span>📋 Raw Webpage Text Extraction Log Streams</span>
            <span class="badge bg-secondary text-white text-uppercase">@statusScrape</span>
        </div>
        <div class="card-body p-3 terminal-log-view">
            @if (!string.IsNullOrEmpty(extractedData))
            {
                <div>@ExtractedDataMarkup</div>
            }
            else
            {
                <span class="text-muted italic">The extraction pipeline log stream is currently blank. Submit a valid URL destination link profile block above.</span>
            }
        </div>
    </div>
</div>
