@page "/"

<PageTitle>AI Chatbot</PageTitle>

<div class="container py-4" style="max-width: 700px;">
    <div class="card shadow">
        <!-- Header -->
        <div class="card-header bg-primary text-white">
            <h3 class="mb-0">🤖 Blazor AI Assistant</h3>
        </div>

        <!-- Chat History Window Box -->
        <div class="card-body overflow-auto" style="height: 450px; background-color: #f8f9fa;">
            @if (_displayMessages.Count == 0)
            {
                <div class="text-center text-muted mt-5">
                    <p>Start a conversation! Type something below...</p>
                </div>
            }
            else
            {
                @foreach (var msg in _displayMessages)
                {
                    <div class="d-flex mb-3 @(msg.Role == "User" ? "justify-content-end" : "justify-content-start")">
                        <div class="p-3 rounded shadow-sm" style="max-width: 80%;
                            background-color: @(msg.Role == "User" ? "#0d6efd" : "#ffffff");
                            color: @(msg.Role == "User" ? "white" : "black");">
                            <strong>@(msg.Role):</strong>
                            <p class="mb-0 text-wrap" style="white-space: pre-line;">@msg.Content</p>
                        </div>
                    </div>
                }
            }
        </div>

        <!-- Input Control Panel -->
        <div class="card-footer bg-white">
            <div class="input-group">
                <input type="text" class="form-control" placeholder="Type your message here..."
                       @bind="_userInput" @bind:event="oninput"
                       @onkeydown="@(e => e.Key == "Enter" ? SendMessage() : Task.CompletedTask)"
                       disabled="@_isTyping" />
                <button class="btn btn-primary" type="button" @onclick="SendMessage" disabled="@_isTyping">
                    @if (_isTyping)
                    {
                        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                    }
                    else
                    {
                        <span>Send</span>
                    }
                </button>
            </div>
        </div>
    </div>
</div>
