@page "/"
@rendermode InteractiveServer

@inject RathodWebScraping.Services.ThemeState ThemeState
@inject NavigationManager NavigationManager
@implements IDisposable

<PageTitle>Rathod Hub - Welcome</PageTitle>

<div class="w-100 d-flex flex-column @(ThemeState.IsDarkMode ? "theme-dark" : "theme-light")" style="height: calc(100vh - 60px); max-height: calc(100vh - 60px); overflow-y: auto;">
    <div class="container-fluid px-4 py-4" style="max-width: 1400px;">

        <div class="hero-header-zone p-5 rounded-4 shadow-sm mb-4 border position-relative overflow-hidden">
            <div class="position-absolute top-0 end-0 p-4 opacity-10 brand-watermark font-monospace select-none">.NET 9</div>
            <div class="d-flex align-items-center gap-4 flex-wrap">
                <img src="images/logo.jpg" alt="Rathod Logo" class="rounded-circle shadow border-brand hero-logo animate-pulse-slow" />
                <div>
                    <h1 class="fw-bold text-main mb-1">Welcome to Rathod AI Hub</h1>
                    <p class="text-muted fs-5 mb-0">Unified Modern Multimodal Web Scraping & Deep AI Analytics Engine Console.</p>
                </div>
            </div>
        </div>

        <div class="row g-4 mb-4">
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card h-100 border-0 shadow-sm scoreboard-card p-4">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="text-muted text-uppercase tracking-wider small fw-bold">Active Chat Sessions</span>
                        <span class="fs-4">💬</span>
                    </div>
                    <h2 class="fw-bold text-main font-monospace mb-1">@totalSessionsCount</h2>
                    <small class="text-success fw-medium">● SQLite Verified</small>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card h-100 border-0 shadow-sm scoreboard-card p-4">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="text-muted text-uppercase tracking-wider small fw-bold">Pipelines Cleaned</span>
                        <span class="fs-4">🌐</span>
                    </div>
                    <h2 class="fw-bold text-main font-monospace mb-1">@scrapedDomainsCount</h2>
                    <small class="text-muted small">HtmlAgilityPack Native</small>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card h-100 border-0 shadow-sm scoreboard-card p-4">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="text-muted text-uppercase tracking-wider small fw-bold">OpenAI Core Models</span>
                        <span class="fs-4">🧠</span>
                    </div>
                    <h2 class="fw-bold text-main font-monospace mb-1">Active</h2>
                    <small class="text-info font-monospace small">Microsoft.Extensions.AI</small>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card h-100 border-0 shadow-sm scoreboard-card p-4">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="text-muted text-uppercase tracking-wider small fw-bold">System Latency</span>
                        <span class="fs-4">⚡</span>
                    </div>
                    <h2 class="fw-bold text-main font-monospace mb-1">Optimal</h2>
                    <small class="text-success fw-medium">Interactive Server Mode</small>
                </div>
            </div>
        </div>

        <div class="row g-4">

            <div class="col-12 col-lg-6">
                <div class="card h-100 border-0 shadow-sm portal-card p-4 d-flex flex-column justify-content-between transition-card">
                    <div>
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <span class="fs-2 text-primary">💬</span>
                            <h3 class="fw-bold mb-0 text-main">AI Chat Assistant</h3>
                        </div>
                        <p class="text-muted mb-4">
                            Launch your isolated SQLite persistent workspace conversation engine. Stream text updates directly using OpenAI, leverage voice recognition features, or run customized operational test metrics.
                        </p>
                    </div>
                    <button @onclick="@(() => NavigateTo("chatbot"))" class="btn btn-primary py-2.5 w-100 fw-semibold tracking-wider">
                        Open Chat Workspace →
                    </button>
                </div>
            </div>

            <div class="col-12 col-lg-6">
                <div class="card h-100 border-0 shadow-sm portal-card p-4 d-flex flex-column justify-content-between transition-card">
                    <div>
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <span class="fs-2 text-info">🌐</span>
                            <h3 class="fw-bold mb-0 text-main">Web Scraper View</h3>
                        </div>
                        <p class="text-muted mb-4">
                            Deploy high-speed web parsing arrays. Strip raw script components dynamically using advanced DOM selectors, populate localized image matrices, and execute full vision engine model updates instantly.
                        </p>
                    </div>
                    <button @onclick="@(() => NavigateTo("webscraper"))" class="btn btn-success py-2.5 w-100 fw-semibold tracking-wider">
                        Open Scraper arrays →
                    </button>
                </div>
            </div>

        </div>

    </div>
</div>